{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linjiang-workshop",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linjiang_workshop",
      "database_id": "c791254a-86e3-4b3f-98f6-a80409afefa4"
    }
  ],
  "routes": [
    {
      "pattern": "workshop.rown.dpdns.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "DISCORD_CLIENT_ID": "REPLACE_WITH_DISCORD_CLIENT_ID",
    "APP_NAME": "临江创意工坊"
  }
}
